# Database Configuration
DATABASE_URL="postgresql://username:password@hostname:port/database"
# For SQLite (default): file:./paylist.db

# Authentication Configuration
AUTH_SECRET="your-super-secret-auth-key-here-minimum-32-characters"

# Application Configuration
NEXTAUTH_URL="http://your-domain-or-ip:3000"
NEXT_PUBLIC_APP_URL="http://your-domain-or-ip:3000"

# Trust Host Configuration
AUTH_TRUST_HOST="true"
NEXTAUTH_SECURE_COOKIE="false"

# Optional: Telegram Notification
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional: LINE Notify
LINE_NOTIFY_TOKEN=""

# Optional: Email Configuration (if needed)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""